{
  "app-id": "net.sourceforge.VMPK",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "vmpk",
  "rename-icon": "vmpk",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--filesystem=xdg-run/pipewire-0:ro",
    "--device=dri",
    "--filesystem=home",
    "--env=TMPDIR=/var/tmp",
    "--env=ALSA_CONFIG_PATH="
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/man",
    "/share/doc",
    "/share/gtk-doc",
    "*.la"
  ],
  "modules": [
    {
      "name": "fluidsynth",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-Denable-sdl3=OFF"
      ],
      "cleanup": [
          "/bin",
          "/include",
          "/lib/cmake",
          "/lib/pkgconfig",
          "/share/man",
          "*.so"
      ],
      "sources": [
          {
              "type": "archive",
              "url": "https://github.com/FluidSynth/fluidsynth/archive/v2.6.2.tar.gz",
              "sha256": "ca376b42a3c1b186a4c8c248931789a455ac94a89b777394969d678010c2f91f"
          },
          {
            "type": "git",
            "url": "https://github.com/kthohr/gcem.git",
            "commit": "012ae73c6d0a2cb09ffe86475f5c6fba3926e200",
            "dest": "gcem"
          }
      ]
    },
    {
      "name": "sonivox",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_APPLICATION=OFF",
        "-DBUILD_TESTING=OFF",
        "-DBUILD_MANPAGE=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/EmbeddedSynth/sonivox/archive/v4.0.2.tar.gz",
          "sha256": "5c513d7a6fa0ebf61afd3b96da881e3014edf53acfb8d08a63dd853fca37c1fa"
        }
      ]
    },
    {
      "name": "drumstick",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_ALSA=ON",
        "-DBUILD_FILE=OFF",
        "-DBUILD_RT=ON",
        "-DBUILD_WIDGETS=ON",
        "-DBUILD_DOCS=OFF",
        "-DBUILD_UTILS=OFF",
        "-DBUILD_TESTING=OFF"
      ],
      "cleanup": [
        "/bin",
        "/lib/plugins",
        "/share/mime",
        "/share/icons/hicolor/*/apps",
        "*.desktop",
        "/lib/*.so"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.sourceforge.net/project/drumstick/2.11.2/drumstick-2.11.2.tar.gz",
          "sha256": "0a40d1bdd301c8e1138578474cf93a923013265503c513b53ce83d043d443ce8"
        }
      ]
    },
    {
      "name": "vmpk",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_DOCS=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.sourceforge.net/project/vmpk/vmpk/0.9.3/vmpk-0.9.3.tar.bz2",
          "sha256": "e53d7b82c232c394928cfce19e4473b2b9d3a8b41b94a42863bed55aa19154db"
        }
      ]
    }
  ]
}
