{
  "app-id": "net.sourceforge.VMPK",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.11",
  "sdk": "org.kde.Sdk",
  "command": "vmpk",
  "rename-icon": "vmpk",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--filesystem=xdg-run/pipewire-0:ro",
    "--device=dri",
    "--filesystem=home",
    "--env=TMPDIR=/var/tmp",
    "--env=ALSA_CONFIG_PATH="
  ],
  "cleanup": [
    "/include",
    "/lib/cmake",
    "/lib/pkgconfig",
    "/share/man",
    "/share/doc",
    "/share/gtk-doc",
    "*.la"
  ],
  "modules": [
    "shared-modules/linux-audio/fluidsynth2.json",
    {
      "name": "sonivox",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_APPLICATION=OFF",
        "-DBUILD_TESTING=OFF",
        "-DBUILD_MANPAGE=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/EmbeddedSynth/sonivox/archive/v4.0.0.tar.gz",
          "sha256": "bd07e384041df010576b2bc1626625465f93ac6ae2e96ae792d0994b816880b1"
        }
      ]
    },
    {
      "name": "drumstick",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_ALSA=ON",
        "-DBUILD_FILE=OFF",
        "-DBUILD_RT=ON",
        "-DBUILD_WIDGETS=ON",
        "-DBUILD_DOCS=OFF",
        "-DBUILD_UTILS=OFF",
        "-DBUILD_TESTING=OFF"
      ],
      "cleanup": [
        "/bin",
        "/lib/plugins",
        "/share/mime",
        "/share/icons/hicolor/*/apps",
        "*.desktop",
        "/lib/*.so"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.sourceforge.net/project/drumstick/2.11.0/drumstick-2.11.0.tar.gz",
          "sha256": "48db17417355a8294dbfa8d10955343f9b8816eb079d6cc9c1fa217579eec8b5"
        }
      ]
    },
    {
      "name": "vmpk",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_DOCS=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.sourceforge.net/project/vmpk/vmpk/0.9.2/vmpk-0.9.2.tar.bz2",
          "sha256": "154548e88a1ee339906bce29a86970fe6cb6470f1fa4c7198bd6d9bbf8332060"
        }
      ]
    }
  ]
}
