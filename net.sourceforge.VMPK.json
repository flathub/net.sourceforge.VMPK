{
  "app-id": "net.sourceforge.VMPK",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "command": "vmpk",
  "rename-icon": "vmpk",
  "finish-args": [
    /* X11 + XShm access */
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    /* PulseAudio */
    "--socket=pulseaudio",
    /* Pipewire */
    "--filesystem=xdg-run/pipewire-0",
    "--device=dri",
    /* Allow loading, saving files from anywhere (portals don’t work yet) */
    "--filesystem=home",
    /* Allow other instances to see lockfiles */
    "--env=TMPDIR=/var/tmp",
    /* On SuSE it seems to be necessary for sound to work */
    "--env=ALSA_CONFIG_PATH="
  ],
  "cleanup": [
    "/share/man",
    "/share/doc",
    "/share/gtk-doc",
    "*.la"
  ],
  "modules": [
    {
      "name": "gcem",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_POLICY_VERSION_MINIMUM=3.5"
      ],
      "cleanup": [
          "/include",
          "/lib/cmake",
          "/lib/pkgconfig"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/kthohr/gcem/archive/v1.18.0.tar.gz",
          "sha256": "8e71a9f5b62956da6c409dda44b483f98c4a98ae72184f3aa4659ae5b3462e61"
        }
      ]
    },
    {
      "name": "fluidsynth",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-Dosal=cpp11"
      ],
      "cleanup": [
          "/bin",
          "/include",
          "/lib/cmake",
          "/lib/pkgconfig",
          "/share/man",
          "*.so"
      ],
      "sources": [
          {
              "type": "archive",
              "url": "https://github.com/FluidSynth/fluidsynth/archive/v2.5.2.tar.gz",
              "sha256": "1dcb13308b3aa383db658c60a7b63d73d0ff4601ccee589582ba7a816475410e"
          }
      ]
    },
    {
      "name": "sonivox",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_APPLICATION=OFF",
        "-DBUILD_TESTING=OFF",
        "-DBUILD_MANPAGE=OFF"
      ],
      "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/lib/*.so"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/EmbeddedSynth/sonivox/archive/v4.0.0.tar.gz",
          "sha256": "bd07e384041df010576b2bc1626625465f93ac6ae2e96ae792d0994b816880b1"
        }
      ]
    },
    {
      "name": "drumstick",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DBUILD_ALSA=ON",
        "-DBUILD_FILE=OFF",
        "-DBUILD_RT=ON",
        "-DBUILD_WIDGETS=ON",
        "-DBUILD_DOCS=OFF",
        "-DBUILD_UTILS=OFF",
        "-DBUILD_TESTING=OFF"
      ],
      "cleanup": [
        "/bin",
        "/include",
        "/lib/cmake",
        "/lib/plugins",
        "/lib/pkgconfig",
        "/share/mime",
        "/share/icons/hicolor/*/apps",
        "*.desktop",
        "/lib/*.so"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.sourceforge.net/project/drumstick/2.11.0/drumstick-2.11.0.tar.gz",
          "sha256": "48db17417355a8294dbfa8d10955343f9b8816eb079d6cc9c1fa217579eec8b5"
        }
      ]
    },
    {
      "name": "vmpk",
      "buildsystem": "cmake-ninja",
      "config-opts": [ "-DBUILD_DOCS=OFF" ],
      "sources": [
        {
          "type": "archive",
          "url": "http://downloads.sourceforge.net/project/vmpk/vmpk/0.9.2/vmpk-0.9.2.tar.bz2",
          "sha256": "154548e88a1ee339906bce29a86970fe6cb6470f1fa4c7198bd6d9bbf8332060"
        }
      ]
    }
  ]
}
